# Copia este archivo como .streamlit/secrets.toml y pon tu clave real.
# secrets.toml está en .gitignore: NUNCA lo subas a GitHub.
# En Streamlit Cloud se pega en: Settings -> Secrets.
# Usa UNA de estas dos opciones:

# Opción 1: Gemini de Google (plan gratis, clave en https://aistudio.google.com)
GEMINI_API_KEY = "..."

# Opción 2: OpenAI (de pago, clave en https://platform.openai.com)
# OPENAI_API_KEY = "sk-..."

# Opcional: cambiar el modelo (por defecto gemini-3.5-flash-lite, con gemini-3.1-flash-lite de respaldo; o gpt-4o-mini)
# MODELO = "gemini-3.8-flash"

# Número de WhatsApp de Bárbara para la tarjeta digital y los afiches con QR
# (con código de país, solo números o con +). Pídele permiso antes de ponerlo.
# WHATSAPP_NUMERO = "+56 9 1234 5678"

# Opcional: dirección pública de la app (para los links y QR)
# APP_URL = "https://nexus-dalmeet.streamlit.app"
